{
  "extends": "../../tsconfig.json",
  "include": [
    "src",
    "dev",
    "vite.config.ts",
    "vitest.config.ts",
  ],
  "exclude": ["dev/dist/**/*"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@test": ["./test/index.ts"]
    },
    "types": [
      "node",
      "vue-router"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "stripInternal": true,
    "skipLibCheck": false
  }
}
