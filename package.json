{
  "name": "@vuetify/vuetify-root",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuetifyjs/vuetify.git"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "lint": "pnpm run -r --parallel --stream lint",
    "lint:fix": "pnpm run -r --parallel lint:fix",
    "version": "node scripts/confirm-npm-tag.js",
    "prepare": "husky; node scripts/post-install.js; $CI || pnpm exec playwright install chromium",
    "postversion": "node scripts/post-release-merge.js",
    "clean": "pnpm -r exec rm -r node_modules && rm -r node_modules",
    "changelog": "conventional-changelog -u -p vuetify",
    "all-checks": "pnpm run -r --stream build && pnpm run lint && pnpm run -r test",
    "vue-ecosystem-ci:build": "pnpm --filter vuetify run build",
    "vue-ecosystem-ci:test": "pnpm --filter vuetify run lint && pnpm --filter vuetify run test"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "devDependencies": {
    "@babel/cli": "catalog:",
    "@babel/core": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@lerna-lite/cli": "catalog:",
    "@lerna-lite/version": "catalog:",
    "@mdi/font": "catalog:",
    "@mdi/js": "catalog:",
    "@mdi/svg": "catalog:",
    "@octokit/core": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "@stylistic/eslint-plugin-ts": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@unhead/vue": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/compiler-sfc": "catalog:",
    "@vue/language-server": "catalog:",
    "@vue/runtime-core": "catalog:",
    "@vue/runtime-dom": "catalog:",
    "@vuetify/github-releaser": "catalog:",
    "@vueuse/head": "catalog:",
    "concurrently": "catalog:",
    "conventional-changelog-cli": "catalog:",
    "conventional-changelog-vuetify": "catalog:",
    "cross-spawn": "catalog:",
    "eslint": "catalog:",
    "eslint-config-standard": "catalog:",
    "eslint-formatter-codeframe": "catalog:",
    "eslint-plugin-import": "catalog:",
    "eslint-plugin-local-rules": "catalog:",
    "eslint-plugin-n": "catalog:",
    "eslint-plugin-promise": "catalog:",
    "eslint-plugin-react": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "eslint-plugin-vuetify": "catalog:",
    "glob": "catalog:",
    "husky": "catalog:",
    "inquirer": "catalog:",
    "lodash-es": "catalog:",
    "magic-string": "catalog:",
    "mkdirp": "catalog:",
    "moment": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "rollup-plugin-dts": "catalog:",
    "rollup-plugin-sass": "catalog:",
    "rollup-plugin-sourcemaps": "catalog:",
    "sass": "catalog:",
    "sass-embedded": "catalog:",
    "semver": "catalog:",
    "shelljs": "catalog:",
    "stringify-object": "catalog:",
    "typescript": "catalog:",
    "upath": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "catalog:",
    "vue-tsc": "catalog:",
    "vuetify": "workspace:*",
    "yargs": "catalog:"
  },
  "packageManager": "pnpm@10.26.1"
}
